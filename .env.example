# Copy to .env and adjust. NEVER commit .env or any real secret.

# ---------------------------------------------------------------- application
APP_ENV=development
LOG_LEVEL=info
LOG_JSON=false
HTTP_ADDR=:8080
SHUTDOWN_TIMEOUT=20s

# ---------------------------------------------------------------- robinhood chain
# Mainnet 4663, testnet 46630. Verified against docs.robinhood.com/chain/connecting/
RH_CHAIN_ID=4663

# The public endpoint is rate-limited and not recommended for production.
# For real use, get an Alchemy key:
#   https://robinhood-mainnet.g.alchemy.com/v2/{API_KEY}
RH_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# WebSocket for push-based block heads. Optional: without it the bot still reads
# the chain over HTTP, it just polls instead of receiving pushes.
#   wss://robinhood-mainnet.g.alchemy.com/v2/{API_KEY}
RH_WS_URL=

RH_REQUEST_TIMEOUT=10s
RH_MAX_RETRIES=3
RH_RETRY_BACKOFF=250ms
# Mark the chain degraded when no new head arrives within this window.
RH_BLOCK_STALE_AFTER=2m

# ---------------------------------------------------------------- postgres
POSTGRES_URL=postgres://hoodalpha:hoodalpha@localhost:5432/hoodalpha?sslmode=disable
POSTGRES_MAX_CONNS=10
POSTGRES_MIN_CONNS=1
POSTGRES_MAX_CONN_LIFETIME=1h
POSTGRES_MAX_CONN_IDLE_TIME=30m
POSTGRES_CONNECT_TIMEOUT=10s

# Used by docker-compose to provision the container.
POSTGRES_DB=hoodalpha
POSTGRES_USER=hoodalpha
POSTGRES_PASSWORD=hoodalpha

# ---------------------------------------------------------------- redis
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_POOL_SIZE=10

# ---------------------------------------------------------------- worker
WORKER_CONCURRENCY=10
WORKER_SHUTDOWN_TIMEOUT=30s

# ---------------------------------------------------------------- risk policy
# Loaded and validated today; no engine consumes these until the risk phase.
STOP_LOSS_PERCENT=5
CAPITAL_RECOVERY_PERCENT=100
MAX_POSITION_PERCENT=5
MAX_OPEN_POSITIONS=5
DAILY_LOSS_LIMIT_PERCENT=10
MAX_SLIPPAGE_BPS=100
MIN_LIQUIDITY_USD=10000
MIN_SCORE=60

# ---------------------------------------------------------------- ports (compose)
HTTP_PORT=8080
POSTGRES_PORT=5432
REDIS_PORT=6379
# Asynqmon has no authentication; compose binds it to 127.0.0.1 only.
ASYNQMON_PORT=8081

# ---------------------------------------------------------------- telegram
# Token from @BotFather. Secret: never commit it, never log it.
# Leaving it blank disables the control plane and the Mini App backend, so the
# api and worker still run without it.
TELEGRAM_BOT_TOKEN=

# Closed allowlist of Telegram numeric user IDs, comma separated. Required
# whenever a bot token is set — an empty allowlist would answer nobody, which
# is indistinguishable from a broken deployment. Get your ID from @userinfobot.
# Usernames are never used for authorization: they are mutable and reusable.
TELEGRAM_ALLOWED_USER_IDS=

# Mini App URL shown by /connect. Optional.
TELEGRAM_MINIAPP_URL=

# How old Mini App initData may be. A short window limits how long a captured
# payload is worth anything; replay is blocked separately via Redis.
TELEGRAM_INITDATA_TTL=15m

# Per-user command budget.
TELEGRAM_RATE_LIMIT=20
TELEGRAM_RATE_WINDOW=1m

# ---------------------------------------------------------------- not yet used
# Later-phase placeholders. No signer exists yet; this build cannot move funds.
BOT_WALLET_ADDRESS=
BOT_WALLET_SIGNER_REF=
